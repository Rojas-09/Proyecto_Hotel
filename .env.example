# ============================================
# HotelBook Pro - Variables de Entorno
# Copiar este archivo a .env y completar los valores
# NUNCA subir .env al repositorio
# ============================================

# Entorno: development | testing | production
FLASK_ENV=development
FLASK_APP=run.py

# Seguridad
SECRET_KEY=genera-una-clave-segura-aqui-con-openssl-rand-hex-32
JWT_SECRET_KEY=genera-otra-clave-diferente-con-openssl-rand-hex-32
JWT_EXPIRATION_HOURS=24
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7
BCRYPT_LOG_ROUNDS=12
# Producción: lista de orígenes CORS separados por coma
# CORS_ORIGINS=https://app.midominio.com,https://admin.midominio.com

# Stripe Mock (development): True para no llamar API real
STRIPE_MOCK=True

# Base de datos
# Desarrollo: dejar vacío para usar SQLite automáticamente
# Producción: usar DATABASE_URL o variables separadas
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotelbook
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui

# Stripe (Pasarela de Pagos)
# Obtener en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Tiempo de expiración de reservas pendientes (minutos)
RESERVA_EXPIRA_MINUTOS=30

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=tu-app-password-de-gmail

# Puerto del servidor (opcional, por defecto 5000)
PORT=5000