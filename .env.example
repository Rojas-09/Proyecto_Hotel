# ============================================
# HotelBook Pro - Variables de Entorno
# Copiar este archivo a .env y completar los valores
# NUNCA subir .env al repositorio
# ============================================

# Entorno: development | testing | production
FLASK_ENV=development
FLASK_APP=run.py

# Seguridad
SECRET_KEY=genera-una-clave-segura-aqui-con-openssl-rand-hex-32
JWT_EXPIRATION_HOURS=24
BCRYPT_LOG_ROUNDS=12

# Base de datos
# Desarrollo: dejar vacío para usar SQLite automáticamente
# Producción: postgresql://usuario:contraseña@host:5432/nombre_db
DATABASE_URL=

# Stripe (Pasarela de Pagos)
# Obtener en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=tu-app-password-de-gmail

# Puerto del servidor (opcional, por defecto 5000)
PORT=5000