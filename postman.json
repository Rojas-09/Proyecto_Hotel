            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Gerente\",\n  \"apellido\": \"Hotel\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Recepcionista no puede editar gerente', () => pm.expect(pm.response.code).to.equal(403));",
                "pm.test('error FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.equal('FORBIDDEN'));"
              ]
            }
          }]
