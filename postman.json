            "url": "{{base_url}}/auth/usuarios/{{usuario_cliente_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Rodriguez\",\n  \"telefono\": \"3001112233\"\n}"
