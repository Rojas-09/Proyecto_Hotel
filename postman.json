          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Gerente puede editar recepcionista', () => pm.expect(pm.response.code).to.equal(200));",
                "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);"
              ]
            }
          }]
        },
        {
          "name": "13.4 Admin edita cliente",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": "{{base_url}}/auth/usuarios/{{usuario_cliente_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Rodriguez\",\n  \"telefono\": \"3002223344\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Admin puede editar cualquiera', () => pm.expect(pm.response.code).to.equal(200));",
                "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);"
              ]
            }
          }]
        },
        {
          "name": "13.5 Recepcionista intenta editar gerente → 403",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_recep}}" }
            ],
