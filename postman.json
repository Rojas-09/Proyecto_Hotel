    {
      "name": "12 — Extras (errores esperados)",
      "item": [
        {
          "name": "12.1 Sin token → 401",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reservas"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Sin token → 401', () => pm.expect(pm.response.code).to.equal(401));"
              ]
            }
          }]
        },
        {
          "name": "12.2 Cliente intenta ver todos reservas → 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_cliente}}" }],
            "url": "{{base_url}}/reservas"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Sin permiso → 403', () => pm.expect(pm.response.code).to.equal(403));"
              ]
            }
          }]
        },
        {
          "name": "12.3 Reserva inexistente → 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{base_url}}/reservas/99999"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('No existe → 404', () => pm.expect(pm.response.code).to.equal(404));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "13 — Pruebas por rol",
      "item": [
        {
          "name": "13.1 Cliente edita su perfil",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
            ],
            "url": "{{base_url}}/auth/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Rodriguez\",\n  \"telefono\": \"3009998888\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Cliente puede editarse', () => pm.expect(pm.response.code).to.equal(200));",
                "pm.test('success true', () => pm.expect(pm.response.json().success).to.be.true);"
              ]
            }
          }]
        },
        {
          "name": "13.2 Recepcionista edita cliente",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_recep}}" }
